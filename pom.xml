<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2250.va_d01d559a_209</version>
    <relativePath />
  </parent>

  <groupId>org.jenkins-ci.plugins</groupId>
  <artifactId>emotional-jenkins-plugin</artifactId>
  <version>${changelist}</version>
  <packaging>hpi</packaging>

  <url>https://github.com/jenkinsci/emotional-jenkins-plugin</url>

  <developers>
    <developer>
      <id>masanobuimai</id>
      <name>Masanobu Imai</name>
    </developer>
    <developer>
      <id>ayyYoSam</id>
      <name>Sam Richard</name>
    </developer>
    <developer>
      <id>mPokornyETM</id>
      <name>Martin Pokorny</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:ssh://github.com/jenkinsci/emotional-jenkins-plugin.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/jenkinsci/emotional-jenkins-plugin.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/jenkinsci/emotional-jenkins-plugin</url>
  </scm>

  <properties>
    <!-- Versioning -->
    <changelist>999999-SNAPSHOT</changelist>
    <gitHubRepo>jenkinsci/${project.artifactId}</gitHubRepo>

    <!-- Java -->
    <java.level>25</java.level>

    <!-- Jenkins baseline -->
    <jenkins.baseline>2.580</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.2</jenkins.version>

    <!-- Quality checks -->
    <spotless.check.skip>false</spotless.check.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>

    <!-- SpotBugs -->
    <spotbugs.effort>Max</spotbugs.effort>
    <spotbugs.threshold>Low</spotbugs.threshold>
  </properties>

</project>
